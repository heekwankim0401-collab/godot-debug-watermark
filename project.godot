; Engine configuration file.
; Test project for the "Debug Watermark" add-on.

config_version=5

[application]

config/name="Debug Watermark (test project)"
config/version="1.0.0"
run/main_scene="res://test/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

DebugWatermark="*res://addons/debug_watermark/debug_watermark.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_watermark/plugin.cfg")
